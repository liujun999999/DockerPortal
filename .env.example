# DockerPortal 部署配置样例
# 复制为 .env 后按需修改：  cp .env.example .env

# Web/API 监听端口（宿主机映射端口）
DP_SERVER_PORT=9800

# JWT 签名密钥
# 留空即可：首次启动会在数据目录（DP_DATA_PATH，容器内为 /app/data）自动生成一个随机密钥
# 并写入 .jwt.key（权限 600）。该文件必须与 H2 数据库文件一同备份——丢了它，所有已登录
# 令牌当场失效；把它连同库文件一起泄露，等同于泄露全部登录凭据。
# 若更希望自行托管密钥（例如由 Vault/密封仓库下发），取消注释并填入：
#   openssl rand -base64 48
# 显式设置后后端不会再生成 .jwt.key。
#DP_JWT_SECRET=

# 匿名初始化入口：首次部署时靠它在浏览器向导里创建管理员账号。
# 装完（含 Docker 环境、Swarm 设置）后设为 false 可彻底关掉该接口。
DP_SETUP_ENABLED=true

# H2 Web 控制台（/h2-console），默认关闭，仅供本地调试数据库时临时打开：
#   开发：DP_H2_CONSOLE=true mvn spring-boot:run
#   容器：compose 只透传下面已列出的环境变量，确实需要在容器里看库时，
#         临时给 environment 加一行 DP_H2_CONSOLE=true，用完删掉
# 注意：控制台无法用 JWT 鉴权，开启即匿名放行，而库里 sa 是空密码；H2 自身只拦非
# loopback 来源，反代到 127.0.0.1 的部署会把它当成“本机”请求，所以公网实例切勿开启。
#DP_H2_CONSOLE=true
