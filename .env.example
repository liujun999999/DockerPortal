# DockerPortal 部署配置样例
# 复制为 .env 后按需修改：  cp .env.example .env

# Web/API 监听端口（宿主机映射端口）
DP_SERVER_PORT=9800

# JWT 签名密钥
# 留空即可：首次启动会在数据目录（DP_DATA_PATH，容器内为 /app/data）自动生成一个随机密钥
# 并写入 .jwt.key（权限 600）。该文件必须与 H2 数据库文件一同备份——丢了它，所有已登录
# 令牌当场失效；把它连同库文件一起泄露，等同于泄露全部登录凭据。
# 若更希望自行托管密钥（例如由 Vault/密封仓库下发），取消注释并填入：
#   openssl rand -base64 48
# 显式设置后后端不会再生成 .jwt.key。
#DP_JWT_SECRET=

# 匿名初始化入口：首次部署时靠它在浏览器向导里创建管理员账号。
# 装完（含 Docker 环境、Swarm 设置）后设为 false 可彻底关掉该接口。
DP_SETUP_ENABLED=true
